<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KyroosApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <!-- Background -->
        <item name="android:background">@color/md_theme_light_background</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <!-- Text colors -->
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/md_theme_light_primaryContainer</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/md_theme_light_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>